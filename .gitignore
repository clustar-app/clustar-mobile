# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Expo ─────────────────────────────────────────────────────
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# ── Native builds (regenerable via `expo prebuild` / EAS) ────
# If you switch to the bare workflow and hand-edit these, remove
# them from this file — but under the managed / prebuild flow
# they're generated on every build.
android/
ios/
!android/app/src/main/AndroidManifest.xml
!ios/*/Info.plist
# (keep these two around only if you've manually customised them)

# ── Metro / Babel caches ─────────────────────────────────────
.metro-health-check*
.metro-cache/
.jest-cache/
haste-map*
*.tsbuildinfo

# ── Signing keys & credentials ───────────────────────────────
# A leaked .jks or .keystore lets an attacker publish updates
# to your app that Android/Play will trust. Never commit these.
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.cer
*.certSigningRequest

# EAS credentials cache
.easignore
credentials.json

# ── Firebase ─────────────────────────────────────────────────
# google-services.json contains only public config that ships
# with the APK — safe to commit if you want. Uncomment the next
# line if you'd rather inject it at build time via EAS secrets.
# google-services.json
# GoogleService-Info.plist

# Firebase Admin SDK service accounts are backend-only. If one
# ever ends up in this folder it's a bug — ignore it defensively.
*firebase-adminsdk*.json
serviceAccount*.json

# ── Environment / secrets ────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development

# ── Merge / conflict cruft ───────────────────────────────────
*.orig.*
*.rej

# ── Logs ─────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Test / coverage ──────────────────────────────────────────
coverage/

# ── Editor / IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS cruft ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
